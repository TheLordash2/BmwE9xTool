<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.thelordash2.bmwe9xtool</ApplicationId>
    <ApplicationTitle>BMW E9x Tool</ApplicationTitle>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../vendor/ediabaslib/EdiabasLib/EdiabasLib/EdiabasLib.csproj"
                      AdditionalProperties="EnableAndroidTargets=true" />
    <ProjectReference Include="../../vendor/ediabaslib/EdiabasLib/AndroidNetBindings/UsbSerialNetBinding/UsbSerialNetBinding.csproj" />
  </ItemGroup>

  <!--
    Optional local starter-data embedding.
    Point E9xStarterDataDir at a locally prepared folder containing:
      ecu/
      ncs/daten/
      ncs/sgdat/
    The data itself is intentionally not committed to the public repository.
  -->
  <ItemGroup Condition="'$(E9xStarterDataDir)' != '' and Exists('$(E9xStarterDataDir)')">
    <AndroidAsset Include="$(E9xStarterDataDir)/**/*"
                  Link="e9x-starter/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
